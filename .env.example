# docker-compose.yml / src/main/resources/application.yaml이 읽는 환경변수 템플릿.
# 실제 값은 이 파일을 복사한 `.env`에 채워 넣는다 (.env는 git-ignore 대상).
#   cp .env.example .env

# --- MySQL (docker-compose mysql 서비스 + backend 서비스가 공유) ---
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 호스트에 이미 로컬 MySQL(3306)이 떠 있을 수 있어 기본값을 3307로 매핑한다.
MYSQL_HOST_PORT=

# --- Redis (docker-compose redis 서비스) ---
REDIS_HOST_PORT=

# --- backend 컨테이너 호스트 노출 포트 ---
APP_HOST_PORT=

# --- JWT (HS256, 최소 256비트/32바이트 필요) ---
APP_JWT_SECRET=
APP_JWT_VALIDITY_MS=

# --- Slack 알림 (Claude Code Stop hook, .claude/settings.json) ---
# Incoming Webhook URL. 비워두면 hook이 조용히 스킵된다.
SLACK_WEBHOOK_URL=

# --- GitHub MCP 서버 (.mcp.json) ---
# repo 접근 권한이 있는 Personal Access Token. .mcp.json은 ${GITHUB_PAT}로 참조만 하므로
# 이 값이 실제로 적용되려면 claude 실행 전에 셸에 export 되어 있어야 한다:
#   export GITHUB_PAT="$(grep '^GITHUB_PAT=' .env | cut -d '=' -f2-)"
GITHUB_PAT=
